    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#InterzoidGetCurrencyRateAPI -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#InterzoidGetCurrencyRateAPI">
        <rdf:type rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#API"/>
        <hasOperations rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getcurrencyrate"/>
        <hasServer rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#https://api.interzoid.com"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getcurrencyrate -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getcurrencyrate">
        <rdf:type rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#Operations"/>
        <hasOutput rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getcurrencyrate.output.200"/>
        <hasParameter rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getcurrencyrate.license"/>
        <hasParameter rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getcurrencyrate.symbol"/>
        <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Use a currency symbol (EUR, GBP, CNY, JPY, AUD, etc.) to obtain a live currency foreign exchange rate for one US Dollar. See the API home page for list of all supported currencies.</hasDescription>
        <hasMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">get</hasMethod>
        <hasPath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">/getcurrencyrate</hasPath>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getcurrencyrate.license -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getcurrencyrate.license">
        <rdf:type rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#Parameter"/>
        <parameterDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Your Interzoid license API key. Register at www.interzoid.com/register</parameterDescription>
        <parameterLocation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">query</parameterLocation>
        <parameterName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">license</parameterName>
        <parameterType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</parameterType>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getcurrencyrate.output.200 -->

