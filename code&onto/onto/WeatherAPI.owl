    <!-- https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#InterzoidGetWeatherByZipCodeAPI -->

    <owl:NamedIndividual rdf:about="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#InterzoidGetWeatherByZipCodeAPI">
        <rdf:type rdf:resource="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#API"/>
        <hasOperations rdf:resource="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode"/>
        <hasServer rdf:resource="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#https://api.interzoid.com"/>
    </owl:NamedIndividual>
    


    <!-- https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#domain -->

    <owl:NamedIndividual rdf:about="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#domain">
        <rdf:type rdf:resource="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#SemanticAnnotation"/>
        <hasDomain>&lt;owl:Ontology rdf:about=&quot;TravelDomainOntology&quot;/&gt;</hasDomain>
    </owl:NamedIndividual>
    


    <!-- https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode -->

    <owl:NamedIndividual rdf:about="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode">
        <rdf:type rdf:resource="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#Operations"/>
        <hasOutput rdf:resource="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode.output.200"/>
        <hasParameter rdf:resource="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode.license"/>
        <hasParameter rdf:resource="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode.zip"/>
        <hasDescription>Use a US zip code to retrieve current weather information</hasDescription>
        <hasMethod>get</hasMethod>
        <hasPath>/getweatherzipcode</hasPath>
    </owl:NamedIndividual>
    


    <!-- https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode.license -->

    <owl:NamedIndividual rdf:about="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode.license">
        <rdf:type rdf:resource="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#Parameter"/>
        <parameterDescription>Your Interzoid license API key. Register at www.interzoid.com/register</parameterDescription>
        <parameterLocation>query</parameterLocation>
        <parameterName>license</parameterName>
        <parameterType>string</parameterType>
    </owl:NamedIndividual>
    


