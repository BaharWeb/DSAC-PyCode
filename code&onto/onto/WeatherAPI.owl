    </owl:NamedIndividual>
    


    <!-- https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode.output.200.schema -->

    <owl:NamedIndividual rdf:about="https://vsr.informatik.tu-chemnitz.de/ontologies/WeatherAPI#getweatherzipcode.output.200.schema">
