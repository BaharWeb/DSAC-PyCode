    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#InterzoidGetGlobalTimeAPI -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#InterzoidGetGlobalTimeAPI">
        <rdf:type rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#API"/>
        <hasOperations rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime"/>
        <hasServer rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#https://api.interzoid.com"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime">
        <rdf:type rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#Operations"/>
        <hasOutput rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.output.200"/>
        <hasParameter rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.license"/>
        <hasParameter rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.locale"/>
        <hasDescription>Gets the current time for a global locale (city, state, region, or country such as Chicago, London, Paris, Seoul, Spain, Buenos Aires, Hawaii, Moscow, Tokyo, Hanoi, etc.)</hasDescription>
        <hasMethod>get</hasMethod>
        <hasPath>/getglobaltime</hasPath>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.license -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.license">
        <rdf:type rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#Parameter"/>
        <parameterDescription>Your Interzoid license API key. Register at www.interzoid.com/register</parameterDescription>
        <parameterLocation>query</parameterLocation>
        <parameterName>license</parameterName>
        <parameterType>string</parameterType>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.locale -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.locale">
        <rdf:type rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#Parameter"/>
        <parameterDescription>Geographic locale to get the current time for</parameterDescription>
        <parameterLocation>query</parameterLocation>
        <parameterName>locale</parameterName>
        <parameterType>string</parameterType>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.output.200 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.output.200">
        <rdf:type rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#Output"/>
        <hasOutputContent rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.output.application/json"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.output.200.schema -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.output.200.schema">
        <rdf:type rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#Schema"/>
        <hasProperties rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.output.200.schema.ClockTime"/>
        <hasProperties rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.output.200.schema.Code"/>
        <hasProperties rdf:resource="http://www.semanticweb.org/baharehzarei/ontologies/2023/0/untitled-ontology-100#getglobaltime.output.200.schema.Credits"/>
