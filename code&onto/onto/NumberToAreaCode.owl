<API rdf:about="#InterzoidGetAreaCodeFromNumberAPI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasServer rdf:resource="#https://api.interzoid.com"/>
  <hasOperations rdf:resource="#getareacodefromnumber"/>
</API>

<Servers rdf:about="#https://api.interzoid.com">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
</Servers>

<Operations rdf:about="#getareacodefromnumber">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasParameter rdf:resource="#getareacodefromnumber.license"/>
  <hasParameter rdf:resource="#getareacodefromnumber.number"/>
  <hasOutput rdf:resource="#getareacodefromnumber.output.200"/>
  <hasPath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">/getareacodefromnumber</hasPath>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The area code will be parsed out of a telephone number and used to retrieve information about the area code.</hasDescription>
  <hasMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">get</hasMethod>
</Operations>

<Parameter rdf:about="#getareacodefromnumber.license">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <parameterDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Your Interzoid license API key. Register at www.interzoid.com/register</parameterDescription>
  <parameterName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">license</parameterName>
  <parameterLocation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">query</parameterLocation>
  <parameterType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</parameterType>
</Parameter>

<Parameter rdf:about="#getareacodefromnumber.number">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <parameterDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Telephone number to retrieve area code information</parameterDescription>
  <parameterName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number</parameterName>
  <parameterLocation rdf:datatype="http://www.w3.org/2001/XMLSchema#string">query</parameterLocation>
  <parameterType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</parameterType>
</Parameter>

<Output rdf:about="#getareacodefromnumber.output.200">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasOutputContent rdf:resource="#getareacodefromnumber.output.application/json"/>
</Output>

<OContent rdf:about="#getareacodefromnumber.output.application/json">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasOoutputSchema rdf:resource="#getareacodefromnumber.output.200.schema"/>
</OContent>

<Schema rdf:about="#getareacodefromnumber.output.200.schema">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasProperties rdf:resource="#getareacodefromnumber.output.200.schema.Abbreviation"/>
  <hasProperties rdf:resource="#getareacodefromnumber.output.200.schema.AreaCode"/>
  <hasProperties rdf:resource="#getareacodefromnumber.output.200.schema.Code"/>
  <hasProperties rdf:resource="#getareacodefromnumber.output.200.schema.Credits"/>
  <hasProperties rdf:resource="#getareacodefromnumber.output.200.schema.Locale"/>
  <hasProperties rdf:resource="#getareacodefromnumber.output.200.schema.PrimaryCity"/>
</Schema>

<Property rdf:about="#getareacodefromnumber.output.200.schema.Abbreviation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Abbreviation</propertyName>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</propertyType>
</Property>

