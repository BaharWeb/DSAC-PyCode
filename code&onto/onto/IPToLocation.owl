<API rdf:about="#ipTwist">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasOperations rdf:resource="#/.post"/>
</API>

<Schema rdf:about="#Request">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasProperties rdf:resource="#Request.ip"/>
</Schema>

<Property rdf:about="#Request.ip">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ip</propertyName>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</propertyType>
</Property>

<Schema rdf:about="#Response">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasProperties rdf:resource="#Response.city"/>
  <hasProperties rdf:resource="#Response.country"/>
  <hasProperties rdf:resource="#Response.country_code"/>
  <hasProperties rdf:resource="#Response.ip"/>
  <hasProperties rdf:resource="#Response.latitude"/>
  <hasProperties rdf:resource="#Response.longitude"/>
  <hasProperties rdf:resource="#Response.state"/>
  <hasProperties rdf:resource="#Response.timezone"/>
  <hasProperties rdf:resource="#Response.zip"/>
</Schema>

<Property rdf:about="#Response.city">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">city</propertyName>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</propertyType>
</Property>

<Property rdf:about="#Response.country">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">country</propertyName>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</propertyType>
</Property>

<Property rdf:about="#Response.country_code">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">country_code</propertyName>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</propertyType>
</Property>

<Property rdf:about="#Response.ip">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ip</propertyName>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</propertyType>
</Property>

<Property rdf:about="#Response.latitude">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">latitude</propertyName>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number</propertyType>
</Property>

<Property rdf:about="#Response.longitude">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">longitude</propertyName>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">number</propertyType>
</Property>

<Property rdf:about="#Response.state">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">state</propertyName>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</propertyType>
</Property>

<Property rdf:about="#Response.timezone">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</propertyType>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">timezone</propertyName>
</Property>

<Property rdf:about="#Response.zip">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <propertyType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">string</propertyType>
  <propertyName rdf:datatype="http://www.w3.org/2001/XMLSchema#string">zip</propertyName>
</Property>

<Operations rdf:about="#/.post">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasRequestBody rdf:resource="#/.post.requestBody"/>
  <hasOutput rdf:resource="#/.post.output.200"/>
  <hasDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string"></hasDescription>
  <hasPath rdf:datatype="http://www.w3.org/2001/XMLSchema#string">/</hasPath>
  <hasMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">post</hasMethod>
</Operations>

<RequestBody rdf:about="#/.post.requestBody">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasRequestBodyContent rdf:resource="#/.post.requestBody.application/json"/>
</RequestBody>

<RBContent rdf:about="#/.post.requestBody.application/json">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasRBSchema rdf:resource="#Request"/>
</RBContent>

<Output rdf:about="#/.post.output.200">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasOutputContent rdf:resource="#/.post.output.application/json"/>
</Output>

<OContent rdf:about="#/.post.output.application/json">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <hasOoutputSchema rdf:resource="#Response"/>
</OContent>


</rdf:RDF>
